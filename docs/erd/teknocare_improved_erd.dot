digraph TeknoCare {
graph [rankdir=TB, bgcolor="white", pad="0.5", nodesep="0.75", ranksep="1.1", splines=polyline, outputorder=edgesfirst, fontname="Arial", labelloc=t, labeljust=l, newrank=true, concentrate=false];
node [shape=plain, fontname="Arial", fontsize=11];
edge [dir=both, color="#728795", penwidth=1.1, arrowsize=0.7, fontname="Arial", fontsize=9, fontcolor="#19343d", labeldistance=2];
label=<<FONT POINT-SIZE="30" COLOR="#19343d"><B>TeknoCare | University Clinic</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="16">Proposed physical ERD / PostgreSQL / 20 entities</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="12">PK = primary key   FK = foreign key   UQ = unique   NN = not null   NULL = optional</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="12">Relationship ends: 1 = exactly one   0..1 = optional one   0..* = zero or more</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="12">Each solid line represents a foreign key. Composite PK: record_diagnosis(record_id, diagnosis_id).</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="12">Slot may retain canceled bookings; only one non-canceled appointment per slot. See README for constraints.</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="12">Design proposal: application models and database have not been migrated.</FONT><BR ALIGN="LEFT"/><BR ALIGN="LEFT"/><FONT POINT-SIZE="12" COLOR="#117c77">Teal: patients</FONT>  |  <FONT POINT-SIZE="12" COLOR="#365ca1">Blue: scheduling</FONT>  |  <FONT POINT-SIZE="12" COLOR="#77519b">Purple: clinical</FONT>  |  <FONT POINT-SIZE="12" COLOR="#a36826">Amber: prescriptions</FONT>>;
"department" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#d5dfe3" BGCOLOR="#eff5f6"><TR><TD COLSPAN="4" BGCOLOR="#19343d" PORT="title"><FONT COLOR="white" POINT-SIZE="14"><B>department</B></FONT></TD></TR><TR><TD><B>Key</B></TD><TD ALIGN="LEFT"><B>Column</B></TD><TD ALIGN="LEFT"><B>PostgreSQL</B></TD><TD><B>Null?</B></TD></TR><TR><TD>PK</TD><TD PORT="department_id" ALIGN="LEFT">department_id</TD><TD ALIGN="LEFT">integer</TD><TD>NN</TD></TR><TR><TD>UQ</TD><TD PORT="code" ALIGN="LEFT">code</TD><TD ALIGN="LEFT">varchar(20)</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(120)</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="is_active" ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">boolean</TD><TD>NN</TD></TR></TABLE>>];
"user" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#d5dfe3" BGCOLOR="#eff5f6"><TR><TD COLSPAN="4" BGCOLOR="#19343d" PORT="title"><FONT COLOR="white" POINT-SIZE="14"><B>user</B></FONT></TD></TR><TR><TD><B>Key</B></TD><TD ALIGN="LEFT"><B>Column</B></TD><TD ALIGN="LEFT"><B>PostgreSQL</B></TD><TD><B>Null?</B></TD></TR><TR><TD>PK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">integer</TD><TD>NN</TD></TR><TR><TD>UQ</TD><TD PORT="school_id" ALIGN="LEFT">school_id</TD><TD ALIGN="LEFT">varchar(20)</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="fname" ALIGN="LEFT">fname</TD><TD ALIGN="LEFT">varchar(50)</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="lname" ALIGN="LEFT">lname</TD><TD ALIGN="LEFT">varchar(50)</TD><TD>NN</TD></TR><TR><TD>UQ</TD><TD PORT="email" ALIGN="LEFT">email</TD><TD ALIGN="LEFT">varchar(100)</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="password_hash" ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="user_type" ALIGN="LEFT">user_type</TD><TD ALIGN="LEFT">varchar(10)</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="account_status" ALIGN="LEFT">account_status</TD><TD ALIGN="LEFT">varchar(10)</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NN</TD></TR></TABLE>>];
"patient" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#d5dfe3" BGCOLOR="#eef9f7"><TR><TD COLSPAN="4" BGCOLOR="#117c77" PORT="title"><FONT COLOR="white" POINT-SIZE="14"><B>patient</B></FONT></TD></TR><TR><TD><B>Key</B></TD><TD ALIGN="LEFT"><B>Column</B></TD><TD ALIGN="LEFT"><B>PostgreSQL</B></TD><TD><B>Null?</B></TD></TR><TR><TD>PK,FK</TD><TD PORT="patient_id" ALIGN="LEFT">patient_id</TD><TD ALIGN="LEFT">integer</TD><TD>NN</TD></TR><TR><TD>FK</TD><TD PORT="department_id" ALIGN="LEFT">department_id</TD><TD ALIGN="LEFT">integer</TD><TD>NULL</TD></TR><TR><TD> </TD><TD PORT="affiliation" ALIGN="LEFT">affiliation</TD><TD ALIGN="LEFT">varchar(10)</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="date_of_birth" ALIGN="LEFT">date_of_birth</TD><TD ALIGN="LEFT">date</TD><TD>NULL</TD></TR><TR><TD> </TD><TD PORT="medical_history_summary" ALIGN="LEFT">medical_history_summary</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD> </TD><TD PORT="created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NN</TD></TR></TABLE>>];
"provider" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#d5dfe3" BGCOLOR="#f7f2fb"><TR><TD COLSPAN="4" BGCOLOR="#77519b" PORT="title"><FONT COLOR="white" POINT-SIZE="14"><B>provider</B></FONT></TD></TR><TR><TD><B>Key</B></TD><TD ALIGN="LEFT"><B>Column</B></TD><TD ALIGN="LEFT"><B>PostgreSQL</B></TD><TD><B>Null?</B></TD></TR><TR><TD>PK,FK</TD><TD PORT="provider_id" ALIGN="LEFT">provider_id</TD><TD ALIGN="LEFT">integer</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="provider_type" ALIGN="LEFT">provider_type</TD><TD ALIGN="LEFT">varchar(20)</TD><TD>NN</TD></TR><TR><TD>UQ</TD><TD PORT="license_number" ALIGN="LEFT">license_number</TD><TD ALIGN="LEFT">varchar(50)</TD><TD>NULL</TD></TR><TR><TD> </TD><TD PORT="specialization" ALIGN="LEFT">specialization</TD><TD ALIGN="LEFT">varchar(100)</TD><TD>NULL</TD></TR><TR><TD> </TD><TD PORT="is_active" ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">boolean</TD><TD>NN</TD></TR></TABLE>>];
"user_profile" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#d5dfe3" BGCOLOR="#eff5f6"><TR><TD COLSPAN="4" BGCOLOR="#19343d" PORT="title"><FONT COLOR="white" POINT-SIZE="14"><B>user_profile</B></FONT></TD></TR><TR><TD><B>Key</B></TD><TD ALIGN="LEFT"><B>Column</B></TD><TD ALIGN="LEFT"><B>PostgreSQL</B></TD><TD><B>Null?</B></TD></TR><TR><TD>PK,FK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">integer</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="phone_number" ALIGN="LEFT">phone_number</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NULL</TD></TR><TR><TD> </TD><TD PORT="home_address" ALIGN="LEFT">home_address</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD> </TD><TD PORT="bio" ALIGN="LEFT">bio</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR></TABLE>>];
"user_settings" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#d5dfe3" BGCOLOR="#eff5f6"><TR><TD COLSPAN="4" BGCOLOR="#19343d" PORT="title"><FONT COLOR="white" POINT-SIZE="14"><B>user_settings</B></FONT></TD></TR><TR><TD><B>Key</B></TD><TD ALIGN="LEFT"><B>Column</B></TD><TD ALIGN="LEFT"><B>PostgreSQL</B></TD><TD><B>Null?</B></TD></TR><TR><TD>PK,FK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">integer</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="dark_mode" ALIGN="LEFT">dark_mode</TD><TD ALIGN="LEFT">boolean</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="email_notifications" ALIGN="LEFT">email_notifications</TD><TD ALIGN="LEFT">boolean</TD><TD>NN</TD></TR></TABLE>>];
"emergency_contact" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#d5dfe3" BGCOLOR="#eef9f7"><TR><TD COLSPAN="4" BGCOLOR="#117c77" PORT="title"><FONT COLOR="white" POINT-SIZE="14"><B>emergency_contact</B></FONT></TD></TR><TR><TD><B>Key</B></TD><TD ALIGN="LEFT"><B>Column</B></TD><TD ALIGN="LEFT"><B>PostgreSQL</B></TD><TD><B>Null?</B></TD></TR><TR><TD>PK</TD><TD PORT="contact_id" ALIGN="LEFT">contact_id</TD><TD ALIGN="LEFT">integer</TD><TD>NN</TD></TR><TR><TD>FK</TD><TD PORT="patient_id" ALIGN="LEFT">patient_id</TD><TD ALIGN="LEFT">integer</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="full_name" ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">varchar(150)</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="relationship" ALIGN="LEFT">relationship</TD><TD ALIGN="LEFT">varchar(50)</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="phone_number" ALIGN="LEFT">phone_number</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="is_primary" ALIGN="LEFT">is_primary</TD><TD ALIGN="LEFT">boolean</TD><TD>NN</TD></TR></TABLE>>];
"patient_allergy" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#d5dfe3" BGCOLOR="#eef9f7"><TR><TD COLSPAN="4" BGCOLOR="#117c77" PORT="title"><FONT COLOR="white" POINT-SIZE="14"><B>patient_allergy</B></FONT></TD></TR><TR><TD><B>Key</B></TD><TD ALIGN="LEFT"><B>Column</B></TD><TD ALIGN="LEFT"><B>PostgreSQL</B></TD><TD><B>Null?</B></TD></TR><TR><TD>PK</TD><TD PORT="allergy_id" ALIGN="LEFT">allergy_id</TD><TD ALIGN="LEFT">integer</TD><TD>NN</TD></TR><TR><TD>FK</TD><TD PORT="patient_id" ALIGN="LEFT">patient_id</TD><TD ALIGN="LEFT">integer</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="allergen" ALIGN="LEFT">allergen</TD><TD ALIGN="LEFT">varchar(150)</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="reaction" ALIGN="LEFT">reaction</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD> </TD><TD PORT="severity" ALIGN="LEFT">severity</TD><TD ALIGN="LEFT">varchar(15)</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="recorded_at" ALIGN="LEFT">recorded_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NN</TD></TR></TABLE>>];
"clinic_room" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#d5dfe3" BGCOLOR="#f0f4fc"><TR><TD COLSPAN="4" BGCOLOR="#365ca1" PORT="title"><FONT COLOR="white" POINT-SIZE="14"><B>clinic_room</B></FONT></TD></TR><TR><TD><B>Key</B></TD><TD ALIGN="LEFT"><B>Column</B></TD><TD ALIGN="LEFT"><B>PostgreSQL</B></TD><TD><B>Null?</B></TD></TR><TR><TD>PK</TD><TD PORT="room_id" ALIGN="LEFT">room_id</TD><TD ALIGN="LEFT">integer</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="campus" ALIGN="LEFT">campus</TD><TD ALIGN="LEFT">varchar(100)</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="building" ALIGN="LEFT">building</TD><TD ALIGN="LEFT">varchar(100)</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="room_number" ALIGN="LEFT">room_number</TD><TD ALIGN="LEFT">varchar(20)</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="is_active" ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">boolean</TD><TD>NN</TD></TR></TABLE>>];
"slot" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#d5dfe3" BGCOLOR="#f0f4fc"><TR><TD COLSPAN="4" BGCOLOR="#365ca1" PORT="title"><FONT COLOR="white" POINT-SIZE="14"><B>slot</B></FONT></TD></TR><TR><TD><B>Key</B></TD><TD ALIGN="LEFT"><B>Column</B></TD><TD ALIGN="LEFT"><B>PostgreSQL</B></TD><TD><B>Null?</B></TD></TR><TR><TD>PK</TD><TD PORT="slot_id" ALIGN="LEFT">slot_id</TD><TD ALIGN="LEFT">integer</TD><TD>NN</TD></TR><TR><TD>FK</TD><TD PORT="provider_id" ALIGN="LEFT">provider_id</TD><TD ALIGN="LEFT">integer</TD><TD>NN</TD></TR><TR><TD>FK</TD><TD PORT="room_id" ALIGN="LEFT">room_id</TD><TD ALIGN="LEFT">integer</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="start_time" ALIGN="LEFT">start_time</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="end_time" ALIGN="LEFT">end_time</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="is_active" ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">boolean</TD><TD>NN</TD></TR></TABLE>>];
"appointment" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#d5dfe3" BGCOLOR="#f0f4fc"><TR><TD COLSPAN="4" BGCOLOR="#365ca1" PORT="title"><FONT COLOR="white" POINT-SIZE="14"><B>appointment</B></FONT></TD></TR><TR><TD><B>Key</B></TD><TD ALIGN="LEFT"><B>Column</B></TD><TD ALIGN="LEFT"><B>PostgreSQL</B></TD><TD><B>Null?</B></TD></TR><TR><TD>PK</TD><TD PORT="appointment_id" ALIGN="LEFT">appointment_id</TD><TD ALIGN="LEFT">integer</TD><TD>NN</TD></TR><TR><TD>FK</TD><TD PORT="patient_id" ALIGN="LEFT">patient_id</TD><TD ALIGN="LEFT">integer</TD><TD>NN</TD></TR><TR><TD>FK</TD><TD PORT="slot_id" ALIGN="LEFT">slot_id</TD><TD ALIGN="LEFT">integer</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="reason_for_visit" ALIGN="LEFT">reason_for_visit</TD><TD ALIGN="LEFT">text</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="status" ALIGN="LEFT">status</TD><TD ALIGN="LEFT">varchar(12)</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="canceled_at" ALIGN="LEFT">canceled_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NULL</TD></TR></TABLE>>];
"medical_record" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#d5dfe3" BGCOLOR="#f7f2fb"><TR><TD COLSPAN="4" BGCOLOR="#77519b" PORT="title"><FONT COLOR="white" POINT-SIZE="14"><B>medical_record</B></FONT></TD></TR><TR><TD><B>Key</B></TD><TD ALIGN="LEFT"><B>Column</B></TD><TD ALIGN="LEFT"><B>PostgreSQL</B></TD><TD><B>Null?</B></TD></TR><TR><TD>PK</TD><TD PORT="record_id" ALIGN="LEFT">record_id</TD><TD ALIGN="LEFT">integer</TD><TD>NN</TD></TR><TR><TD>FK,UQ</TD><TD PORT="appointment_id" ALIGN="LEFT">appointment_id</TD><TD ALIGN="LEFT">integer</TD><TD>NULL</TD></TR><TR><TD>FK</TD><TD PORT="patient_id" ALIGN="LEFT">patient_id</TD><TD ALIGN="LEFT">integer</TD><TD>NN</TD></TR><TR><TD>FK</TD><TD PORT="provider_id" ALIGN="LEFT">provider_id</TD><TD ALIGN="LEFT">integer</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="chief_complaint" ALIGN="LEFT">chief_complaint</TD><TD ALIGN="LEFT">text</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="symptoms" ALIGN="LEFT">symptoms</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD> </TD><TD PORT="examination_notes" ALIGN="LEFT">examination_notes</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD> </TD><TD PORT="treatment_plan" ALIGN="LEFT">treatment_plan</TD><TD ALIGN="LEFT">text</TD><TD>NULL</TD></TR><TR><TD> </TD><TD PORT="status" ALIGN="LEFT">status</TD><TD ALIGN="LEFT">varchar(10)</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="visited_at" ALIGN="LEFT">visited_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="finalized_at" ALIGN="LEFT">finalized_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD>NULL</TD></TR></TABLE>>];
