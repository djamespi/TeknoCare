"diagnosis" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#d5dfe3" BGCOLOR="#f7f2fb"><TR><TD COLSPAN="4" BGCOLOR="#77519b" PORT="title"><FONT COLOR="white" POINT-SIZE="14"><B>diagnosis</B></FONT></TD></TR><TR><TD><B>Key</B></TD><TD ALIGN="LEFT"><B>Column</B></TD><TD ALIGN="LEFT"><B>PostgreSQL</B></TD><TD><B>Null?</B></TD></TR><TR><TD>PK</TD><TD PORT="diagnosis_id" ALIGN="LEFT">diagnosis_id</TD><TD ALIGN="LEFT">integer</TD><TD>NN</TD></TR><TR><TD>UQ</TD><TD PORT="code" ALIGN="LEFT">code</TD><TD ALIGN="LEFT">varchar(20)</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="description" ALIGN="LEFT">description</TD><TD ALIGN="LEFT">varchar(255)</TD><TD>NN</TD></TR><TR><TD> </TD><TD PORT="coding_system" ALIGN="LEFT">coding_system</TD><TD ALIGN="LEFT">varchar(30)</TD><TD>NN</TD></TR></TABLE>>];
